# Oturum imzalama anahtarı (production'da en az 32 karakter rastgele değer zorunlu)
SESSION_SECRET=degistir-bunu-en-az-32-karakter-rastgele-deger

# Boş bırakılırsa gömülü PGlite (WASM Postgres) kullanılır: ./.data/pglite
# Production için gerçek PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/havuz

# Boş veritabanında demo verisi otomatik yüklensin mi? (production'da false)
AUTO_SEED=true
