# ---------------------------------------------------------------------------
# Havuz ortam değişkenleri. Kopyalayın: cp .env.example .env
# Gizli değerleri (anahtarlar, şifreler) ASLA depoya eklemeyin.
# ---------------------------------------------------------------------------

# Uygulamanın dışarıdan erişilen adresi (e-posta bağlantıları ve iyzico dönüşü için)
APP_URL=http://localhost:3100

# Oturum imzalama anahtarı — production'da en az 32 karakter rastgele (örn. `openssl rand -base64 48`)
SESSION_SECRET=

# Veritabanı. Boşsa gömülü PGlite (./.data/pglite) kullanılır; production'da PostgreSQL zorunlu.
# DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/havuz

# Boş veritabanına demo verisi (production'da false)
AUTO_SEED=true

# --- Ödeme ---------------------------------------------------------------
# test   : uygulama içi test ödeme sayfası (gerçek para çekilmez)
# iyzico : iyzico Checkout Form
PAYMENT_PROVIDER=test
# Production'da test modunu açmak için (yalnızca demo sunucusu):
# PAYMENT_ALLOW_TEST=true

# iyzico anahtarları: panel → Firma Ayarları → API Anahtarları. "=" işaretinden sonra yapıştırın.
# Kontrol: havuz klasöründe `npm run iyzico:check`
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# iyzico hesabınız Pazaryeri olarak tanımlandığında true yapın: ödeme tedarikçi payı ayrılarak alınır,
# tedarikçiye iyzico öder. false iken standart hesap: hakedişler Havuz tarafından havaleyle ödenir.
IYZICO_MARKETPLACE=false
# (İsteğe bağlı) iyzico pazaryerinde her kalemde alt satıcı isterse, Pro üyelik gibi Havuz'un kendi
# satışları için Havuz adına açılmış alt satıcı anahtarı:
# IYZICO_PLATFORM_SUBMERCHANT_KEY=
# İade isteklerinde gönderilen sunucu IP'si (iyzico zorunlu alan):
# SERVER_PUBLIC_IP=
# Test sağlayıcısında pazaryeri taklidini kapatmak için: PAYMENT_MARKETPLACE=false

# --- E-posta -------------------------------------------------------------
# console : sunucu kaydına yazar (geliştirme)   resend : Resend API
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Havuz <bildirim@alanadiniz.com>"

# --- WhatsApp ------------------------------------------------------------
# console | cloud (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=havuz_bildirim     # Meta onaylı, tek gövde parametreli şablon

# --- Zamanlanmış bakım ---------------------------------------------------
# Uzun ömürlü sunucuda (Docker / next start) dakikada bir kendiliğinden çalışır.
# Sunucusuz ortamda (Vercel) /api/v1/cron/maintenance uç noktası çağrılır:
# CRON_SECRET=
# HAVUZ_SCHEDULER=off
